# Copy to backend/.env and fill in. Never commit the real .env.
PORT=4000
DB_FILE=./data/sa_pos.db
# Required when NODE_ENV=production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
# Used only when the database is first created.
OWNER_ID=owner
OWNER_PASSWORD=change-me-now
NODE_ENV=development
